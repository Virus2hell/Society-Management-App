# Copy this file to ".env" (same folder) and fill in your values.

# PostgreSQL connection string.
#  - Neon (recommended): Dashboard -> Connect -> copy the connection string
#    e.g. postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#  - Local Postgres:     postgresql://postgres:postgres@localhost:5432/society
DATABASE_URL=

# Any long random text. Used to sign login tokens. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

# Port for the API (hosting platforms set this automatically)
PORT=4000

# Insert demo society + users when the database is empty (true/false)
SEED_DEMO=true

# Only for Supabase pooler or other hosts with custom SSL certificates:
# DATABASE_SSL_NO_VERIFY=true
